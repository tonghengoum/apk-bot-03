[Unit]
Description=IT Bot Telegram Service
After=network.target

[Service]
Type=simple
User=yourusername  # Replace with the actual user or leave as is for the current user
WorkingDirectory=/path/to/your/repository/bot  # Replace with the actual path
EnvironmentFile=/path/to/your/repository/.env  # Replace with the actual path
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target