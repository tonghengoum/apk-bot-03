[Unit]
Description=IT Bot Control API Service
After=network.target

[Service]
Type=simple
User=yourusername  # Replace with the actual user or leave as is for the current user
WorkingDirectory=/path/to/your/repository/api  # Replace with the actual path
EnvironmentFile=/path/to/your/repository/.env  # Replace with the actual path
ExecStart=/usr/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target