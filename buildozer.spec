[app]

# (str) Title of your application
title = IT Bot Remote Control

# (str) Package name
package.name = itbotremote

# (str) Package domain (needed for android/ios packaging)
package.domain = org.example

# (str) Source code where the main app live
source.dir = app

# (list) Source files to include (let empty to include all the files)
source.include_exts = py,png,jpg,kv,atlas

# (list) Application requirements
# comma separated e.g. requirements = sqlite3,kivy
requirements = python3,kivy==2.1.0,requests

# (str) Supported orientation (one of landscape, sensorLandscape, portrait or all)
orientation = portrait

# (bool) Indicate if the application should be fullscreen or not
fullscreen = 0

# (str) Application versioning method (see versioning.txt)
version = 0.1

# (str) Application version
version.code = 1

# (str) Application build number
build.number = 1

# (str) Application identifier (used for android/ios packaging)
# identifier = org.example.itbotremote

# (list) Application permissions
# permissions = INTERNET

# (str) Presplash image (filename relative to source directory)
# (str) Presplash background color (format is #aarrggbb)
#presplash.color = #FFFFFF

# (list) Icons to use (list of filenames relative to source directory)
# (str) Icon filename (filename relative to source directory)
#icon.filename = %(source.dir)s/data/icon.png

# (str) Supported orientation (one of landscape, sensorLandscape, portrait or all)
orientation = portrait

